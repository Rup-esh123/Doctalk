# ==============================================================================
# DocTALK Healthcare Platform — Environment Variables Example
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# General
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://doctalk_user:doctalk_password@localhost:5432/doctalk?schema=public"

# Cache & Queues (Redis 7)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
# Generate secrets using `openssl rand -hex 32`
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_JWT_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_JWT_REFRESH_SECRET"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Field-Level Encryption Key for Clinical PHI (32-byte hex string = 64 hex characters)
CLINICAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Payment Gateway (Razorpay — India First)
# Test credentials from https://dashboard.razorpay.com/#/access/api-keys
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Object Storage (S3-compatible, private bucket, signed URLs)
# Local dev uses MinIO; Production uses AWS S3 Mumbai or Cloudflare R2
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="doctalk-private"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_REGION="ap-south-1"

# Telemedicine Video & Audio Provider (LiveKit / 100ms)
VIDEO_PROVIDER="mock" # Options: mock | livekit | 100ms
LIVEKIT_URL="wss://doctalk-dev.livekit.cloud"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret"

# Transactional Email (Resend / Mailpit for local dev)
EMAIL_PROVIDER="mock" # Options: mock | resend | smtp
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DocTALK Health <care@doctalk.in>"

# AI Assistive Features (Disabled by default per D-009 / D-018 / O-3)
AI_PROVIDER="mock" # Options: mock | openai | anthropic
AI_API_KEY=""
AI_MONTHLY_BUDGET_USD=50

# Feature Flags (D-035)
FEATURE_INSTANT_CONSULT=false
FEATURE_AI_INTAKE=false
FEATURE_AI_SUMMARY=false
FEATURE_SUBSCRIPTIONS=true
FEATURE_INTL=false
